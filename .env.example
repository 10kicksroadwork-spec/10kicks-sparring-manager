# Google sign-in is optional and off unless this is 1. The live desk opens without it.
# AUTH_REQUIRED=1

# Used only when AUTH_REQUIRED=1. Real values belong in the host secret store, never in git.
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_GOOGLE_ID=REPLACE_WITH_OAUTH_CLIENT_ID
AUTH_GOOGLE_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET

# Role allowlists. Lower-case emails, comma-separated. Do not invent real coaches.
ADMIN_EMAILS=admin@example.com
COACH_EMAILS=coach1@example.com,coach2@example.com
VIEWER_EMAILS=

# Supabase is the source of truth. The URL is public. The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY_IN_SECRET_SETTINGS

# Google Sheets is unused. Do not put a service-account JSON in the app.
# GOOGLE_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional. Production uses a Postgres lock when Supabase is configured.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# General
APP_TIMEZONE=America/New_York

# Local tests only. Production rejects SPARRING_STORE=memory and ignores E2E_TEST_AUTH.
# SPARRING_STORE=memory
# E2E_TEST_AUTH=1
