# Auth.js Google OAuth web client. Real values belong in the host secret store, never in git.
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_GOOGLE_ID=REPLACE_WITH_OAUTH_CLIENT_ID
AUTH_GOOGLE_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET

# Role allowlists. Lower-case emails, comma-separated. Do not invent real coaches.
ADMIN_EMAILS=admin@example.com
COACH_EMAILS=coach1@example.com,coach2@example.com
VIEWER_EMAILS=

# Google Sheets service account. The gym account owns the spreadsheet.
GOOGLE_SPREADSHEET_ID=REPLACE_WITH_GYM_OWNED_SPREADSHEET_ID
GOOGLE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_PRIVATE_JSON_ONLY_IN_SECRET_SETTINGS

# Server-side locks. Writes fail closed when these are missing in production.
UPSTASH_REDIS_REST_URL=REPLACE_WITH_REDIS_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_REDIS_SECRET

# General
APP_TIMEZONE=America/New_York

# Local tests only. Production rejects SPARRING_STORE=memory and ignores E2E_TEST_AUTH.
# SPARRING_STORE=memory
# E2E_TEST_AUTH=1
